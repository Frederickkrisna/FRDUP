# Copy to .env.local and fill in from Firebase Console -> Project settings -> Your apps -> Web app.
# These values are public client identifiers (not secrets), but keep .env.local out of version control.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to 1 to point the app at the local Firestore + Auth emulators (npm run emulators).
VITE_USE_EMULATOR=

# Optional: origin used in links/QR codes opened on OTHER phones (co-host join, public board).
# Leave empty in production (the page origin is used). In dev, `localhost` is unreachable from a
# second phone: run `npm run dev -- --host` and set e.g. http://192.168.1.10:5173 here.
VITE_PUBLIC_ORIGIN=
