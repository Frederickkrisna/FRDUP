{
  "name": "frdup",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FRDUP — mobile-first PWA for recreational sports sessions: fair matchmaking, live scoring, rank tiers, split bill, Instagram-ready leaderboards.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-frdup-rules \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "firebase emulators:exec --only firestore,auth --project demo-frdup \"playwright test\"",
    "emulators": "firebase emulators:start --only firestore,auth --project demo-frdup",
    "icons": "pwa-assets-generator",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "firebase": "13.0.0",
    "html-to-image": "1.11.13",
    "i18next": "26.4.7",
    "immer": "11.1.21",
    "lucide-react": "1.59.0",
    "motion": "14.3.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.0.20",
    "react-is": "19.3.1",
    "react-router": "8.4.0",
    "recharts": "3.10.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint/js": "9.39.5",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
